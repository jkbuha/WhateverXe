+static inline IOSimpleLock *xeAppleFwLock(uint8_t *a) {
+	void *holder = *reinterpret_cast<void **>(a + 0x1468);
+	return holder ? *reinterpret_cast<IOSimpleLock **>(holder) : nullptr;
+}
