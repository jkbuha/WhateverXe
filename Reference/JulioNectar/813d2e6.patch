+				if (gFwActSeq == seq && gCs5SubmitN == sub) {  // nobody took/released forcewake meanwhile
+					uint32_t drop = 0;
+					int32_t c0 = cnt[0], c1 = cnt[1], c2 = cnt[2];
+					for (unsigned i = 0; i < 3; i++) {
